.fvec projection[4]
.constf constants(0.0, 1.0, 32.0, 0.0)
.constf factors(0.0625, 0.03125, 0.125, 0.0)
.out position position
.out even_uv texcoord0
.out odd_uv texcoord1
.out checker_uv texcoord2
.out color color
.in point v0
.in indices v1
.in scale v2
.entry main
.proc main
    mov r0.xy, point
    mov r0.z, constants.x
    mov r0.w, constants.y
    dp4 position.x, projection[0], r0
    dp4 position.y, projection[1], r0
    dp4 position.z, projection[2], r0
    dp4 position.w, projection[3], r0
    mul r1.xy, factors.xxxx, indices
    flr r2.xy, r1
    add r1.xy, r1, -r2
    add r1.xy, factors.yyyy, r1
    mul r2.xy, factors.xxxx, r2
    add r2.xy, factors.yyyy, r2
    add r2.xy, constants.yyyy, -r2
    mov even_uv.x, r1.x
    mov even_uv.y, r2.x
    mov odd_uv.x, r1.y
    mov odd_uv.y, r2.y
    rcp r3.x, scale.x
    mul r3.x, factors.z, r3.x
    mul r3.yz, point.xxyy, r3.xxxx
    ; An integer number of repeat periods keeps the same checker phase while
    ; avoiding negative UV rounding in software PICA implementations.
    add r3.z, constants.z, -r3.z
    mov checker_uv.xy, r3.yz
    mov color, constants.yyyy
    end
.end
